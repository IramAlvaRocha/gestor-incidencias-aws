// Modelo objetivo arena. Nullable y referencias reales; sin FK entre servicios.
// Expresiones generadas y CHECK completos: ver SQL.
Project arena_target { database_type: 'MySQL' }

Table app_user {
  Note: 'Perfil local estable; conserva los UUID de User.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  display_name varchar(160) [not null]
  email_display varchar(254) [not null]
  status varchar(32) [not null, note: 'Enum de dominio validado en servidor']
  version int [not null, note: 'Control optimista, incremento atómico']
  created_at datetime(3) [not null, note: 'Instante UTC']
}

Table identity_link {
  Note: 'Vincula cuenta local a un emisor; no unir por email.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  user_id char(36) [not null]
  issuer varchar(255) [not null]
  subject varchar(255) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (issuer, subject) [unique]
  }
}

Table employee {
  Note: 'Empleado de la agencia y rol administrativo global.'
