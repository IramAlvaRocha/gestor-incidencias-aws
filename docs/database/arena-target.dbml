  classification_snapshot json
  current_group_id char(36)
  assignee_user_id char(36)
  sla_mode varchar(32) [not null, note: 'ACTIVE, NONE o LEGACY_UNMEASURED; ausencia explícita, nunca SLA cero']
  resolution_code varchar(64)
  resolution_summary text
  cancellation_reason text
  accepted_at datetime(3) [not null]
  resolved_at datetime(3)
  closed_at datetime(3)
  updated_at datetime(3) [not null]
  version int [not null, note: 'Control optimista, incremento atómico']
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (project_id, number) [unique]
    (ticket_key) [unique]
    (client_id, project_id, status, updated_at)
    (assignee_user_id, status)
  }
}

Table ticket_ci {
  Note: 'CI afectado, principal o secundario; nunca duplicado.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  ci_id char(36) [not null]
  is_primary boolean [not null]
  snapshot json [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (ticket_id, ci_id) [unique]
  }
}

Table ticket_comment {
  Note: 'Comentario público o nota interna; sin borrado cascada.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  author_user_id char(36) [not null]
  visibility varchar(32) [not null]
  body text [not null]
  edited_at datetime(3)
  version int [not null, note: 'Control optimista, incremento atómico']
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
  }
}

Table attachment {
  Note: 'Metadatos y visibilidad; archivo privado en S3.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  comment_id char(36)
  uploaded_by char(36) [not null]
  object_key varchar(512) [not null]
  file_name varchar(160) [not null]
  content_type varchar(160) [not null]
  size_bytes bigint [not null]
  checksum char(64)
  visibility varchar(32) [not null]
  scan_status varchar(32) [not null]
  verified_at datetime(3)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
  }
}

Table ticket_participant {
  Note: 'Participante concede alcance; follower solo notifica.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  user_id char(36) [not null]
  kind varchar(32) [not null]
  added_by char(36) [not null]
  status varchar(32) [not null, note: 'Enum de dominio validado en servidor']
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (ticket_id, user_id, kind) [unique]
  }
}

Table ticket_relation {
  Note: 'Relación autorizada entre tickets; ciclos según tipo.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  source_ticket_id char(36) [not null]
  target_ticket_id char(36) [not null]
  kind varchar(32) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (source_ticket_id, target_ticket_id, kind) [unique]
  }
}

Table tag {
  Note: 'Etiqueta de proyecto.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  project_id char(36) [not null]
  name varchar(30) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (project_id, name) [unique]
  }
}

Table ticket_tag {
  Note: 'Etiquetas del ticket.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  tag_id char(36) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (ticket_id, tag_id) [unique]
  }
}

Table ticket_event {
  Note: 'Hecho inmutable con versión por agregado y proyección pública revisada.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  sequence bigint [not null]
  event_type varchar(64) [not null]
  actor_user_id char(36)
  occurred_at datetime(3) [not null]
  visibility varchar(32) [not null]
  payload json [not null]
  request_id varchar(64) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (ticket_id, sequence) [unique]
    (ticket_id, occurred_at)
  }
}

Table ticket_assignment {
  Note: 'Historia de custodios. La cola actual conserva el ticket durante transferencia.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  group_id char(36) [not null]
  assignee_user_id char(36)
  started_at datetime(3) [not null]
  ended_at datetime(3)
  reason text [not null]
  assigned_by char(36) [not null]
  routing_rule_id char(36)
  created_at datetime(3) [not null, note: 'Instante UTC']
  open_ticket_id char(36) [note: 'Clave generada: una fila activa por agregado']
  indexes {
    (client_id, id) [unique]
    (open_ticket_id) [unique]
  }
}

Table ticket_transfer {
  Note: 'Solicitar, aceptar, declinar o cancelar traslado; no es rechazo del ticket.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  from_assignment_id char(36) [not null]
  to_group_id char(36) [not null]
  requested_by char(36) [not null]
  reason text [not null]
  status varchar(32) [not null, note: 'Enum de dominio validado en servidor']
  decided_by char(36)
  decision_reason text
  decided_at datetime(3)
  review_due_at datetime(3) [not null]
  result_assignment_id char(36)
  version int [not null, note: 'Control optimista, incremento atómico']
  created_at datetime(3) [not null, note: 'Instante UTC']
  pending_ticket_id char(36) [note: 'Clave generada: una fila activa por agregado']
  indexes {
    (client_id, id) [unique]
    (pending_ticket_id) [unique]
  }
}

Table ticket_cycle {
  Note: 'Ciclo 1 al aceptar; siguientes al reabrir con motivo.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  cycle_number int [not null]
  started_at datetime(3) [not null]
  ended_at datetime(3)
  outcome varchar(32)
  reason text
  created_at datetime(3) [not null, note: 'Instante UTC']
  open_ticket_id char(36) [note: 'Clave generada: una fila activa por agregado']
  indexes {
    (client_id, id) [unique]
    (ticket_id, cycle_number) [unique]
    (open_ticket_id) [unique]
  }
}

Table sla_evaluation {
  Note: 'Entrada y resultado congelados; también registra overrides y migraciones.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  cycle_id char(36) [not null]
  policy_version_id char(36) [not null]
  rule_id char(36) [not null]
  input_snapshot json [not null]
  result_snapshot json [not null]
  evaluated_at datetime(3) [not null]
  engine_version varchar(64) [not null]
  reason text [not null]
  actor_user_id char(36)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
  }
}

Table ticket_sla_clock {
  Note: 'Estado materializado independiente para primera respuesta y resolución.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  ticket_id char(36) [not null]
  cycle_id char(36) [not null]
  metric varchar(32) [not null]
  state varchar(32) [not null]
  started_at datetime(3) [not null]
  consumed_ms bigint [not null]
  checkpoint_at datetime(3) [not null]
  due_at datetime(3) [note: 'NULL si pausado; fecha calculada si corre']
  last_due_at datetime(3)
  breached_at datetime(3) [note: 'Primer incumplimiento, irreversible']
  completed_at datetime(3)
  active_revision_number int [not null]
  version int [not null, note: 'Control optimista, incremento atómico']
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (cycle_id, metric) [unique]
    (state, due_at)
  }
}

Table sla_clock_revision {
  Note: 'Presupuesto y calendario aplicados; crear otra fila al cambiar, no UPDATE.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  clock_id char(36) [not null]
  revision_number int [not null]
  evaluation_id char(36) [not null]
  target_id char(36) [not null]
  calendar_version_id char(36) [not null]
  target_ms bigint [not null]
  consumed_at_change_ms bigint [not null]
  effective_at datetime(3) [not null]
  reason text [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (clock_id, revision_number) [unique]
  }
}

Table sla_pause {
  Note: 'Pausa autorizada por reloj. Intervalos [start,end); no doble descuento.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  clock_id char(36) [not null]
  started_at datetime(3) [not null]
  ended_at datetime(3)
  reason_code varchar(64) [not null]
  reason_text text [not null]
  trigger_comment_id char(36)
  started_by char(36) [not null]
  ended_by char(36)
  auto_resume_at datetime(3)
  review_at datetime(3)
  dedupe_key varchar(64) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  open_clock_id char(36) [note: 'Clave generada: una fila activa por agregado']
  indexes {
    (client_id, id) [unique]
    (clock_id, dedupe_key) [unique]
    (open_clock_id) [unique]
  }
}

Table sla_clock_event {
  Note: 'Traza del cálculo, checkpoint y vencimiento histórico antes/después.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  clock_id char(36) [not null]
  sequence bigint [not null]
  event_type varchar(64) [not null]
  occurred_at datetime(3) [not null]
  delta_consumed_ms bigint [not null]
  payload json [not null]
  source_event_id char(36)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (clock_id, sequence) [unique]
  }
}

Table sla_alert {
  Note: 'Dedupe de alertas por revisión; workers comprueban versión vigente.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  clock_id char(36) [not null]
  revision_number int [not null]
  kind varchar(64) [not null]
  scheduled_at datetime(3) [not null]
  delivered_at datetime(3)
  cancelled_at datetime(3)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (clock_id, revision_number, kind) [unique]
    (scheduled_at, delivered_at)
  }
}

Table outbox_event {
  Note: 'Evento durable para avisos; no publicar a SQS antes del commit.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  aggregate_id char(36) [not null]
  event_type varchar(64) [not null]
  payload json [not null]
  available_at datetime(3) [not null]
  published_at datetime(3)
  attempts int [not null]
  locked_until datetime(3)
  lease_owner varchar(64)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (published_at, available_at)
  }
}

Table consumer_receipt {
  Note: 'Idempotencia por consumidor y evento.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  consumer varchar(64) [not null]
  event_id char(36) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (consumer, event_id) [unique]
  }
}

Table notification {
  Note: 'Notificación con referencia; reautorizar al leer y al enviar.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  recipient_user_id char(36) [not null]
  ticket_id char(36)
  source_event_id char(36) [not null]
  kind varchar(64) [not null]
  read_at datetime(3)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (recipient_user_id, source_event_id, kind) [unique]
  }
}

Table notification_preference {
  Note: 'Preferencias por canal y clase de evento.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  user_id char(36) [not null]
  channel varchar(32) [not null]
  event_type varchar(64) [not null]
  enabled boolean [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (user_id, channel, event_type) [unique]
  }
}

Table notification_delivery {
  Note: 'Intentos de entrega y resultado del proveedor.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  notification_id char(36) [not null]
  channel varchar(32) [not null]
  attempt int [not null]
  status varchar(32) [not null, note: 'Enum de dominio validado en servidor']
  provider_message_id varchar(160)
  sent_at datetime(3)
  last_error_code varchar(64)
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
    (notification_id, channel, attempt) [unique]
  }
}

Table idempotency_record {
  Note: 'Clave por actor y operación; reautorizar todo replay.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  actor_user_id char(36) [not null]
  operation varchar(64) [not null]
  request_key varchar(64) [not null]
  request_hash char(64) [not null]
  resource_id char(36)
  status varchar(32) [not null]
  expires_at datetime(3) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (actor_user_id, operation, request_key) [unique]
  }
}

Table audit_event {
  Note: 'Auditoría restringida; retención separada y exportación inmutable.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36)
  actor_user_id char(36)
  resource_type varchar(64) [not null]
  resource_id char(36)
  action varchar(64) [not null]
  request_id varchar(64) [not null]
  payload_redacted json [not null]
  occurred_at datetime(3) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, occurred_at)
  }
}

Table export_job {
  Note: 'Exportación de alcance congelado, permiso revalidado antes de descargar.'
  id char(36) [pk, not null, note: 'Identificador UUID generado por aplicación']
  client_id char(36) [not null]
  requested_by char(36) [not null]
  filters json [not null]
  status varchar(32) [not null, note: 'Enum de dominio validado en servidor']
  object_key varchar(512)
  expires_at datetime(3) [not null]
  created_at datetime(3) [not null, note: 'Instante UTC']
  indexes {
    (client_id, id) [unique]
  }
}

